# Device files of fake GPUs declared in /etc/slurm/fake_gpus.conf.
#
# Slurm drops a GPU from the device list it uses for job environment when its
# file is not a character or block device. Each /dev/nvidiaN is a link to
# /dev/null, a character device the container can always access, so jobs get
# SLURM_JOB_GPUS, SLURM_STEP_GPUS and CUDA_VISIBLE_DEVICES. All GPUs share
# device 1:3, which would not work with task/cgroup ConstrainDevices.
{% set total = slurm_current_compute_node_type['gpus'].values() | sum %}
{% for index in range(total) %}
L /dev/nvidia{{ index }} - - - - /dev/null
{% endfor %}
