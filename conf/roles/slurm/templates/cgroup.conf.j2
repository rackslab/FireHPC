{% if slurm_emulator | bool %}
# One slurmd per virtual node would otherwise keep a system D-Bus connection
# to create its systemd scope. dbus refuses connections after 256 per UID.
CgroupPlugin=cgroup/v2
IgnoreSystemd=yes
{% endif %}
{% if not (slurm_emulator | bool) and slurm_task_cgroup | bool %}
# Confine jobs to their allocated cores and memory.
#
# ConstrainDevices is not enabled. All fake GPUs are links to /dev/null, so
# denying the GPUs not allocated to a job would deny /dev/null to that job.
ConstrainCores=yes
ConstrainRAMSpace=yes
{% endif %}
{% if slurm_cgroup_job_id_paths_applied | default(false) | bool %}
# Name cgroup/v2 job cgroups job_<id> instead of the job SLUID.
CgroupJobIdPaths=yes
{% endif %}
