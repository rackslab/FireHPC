[Unit]
Description=Slurm node daemon instance %i
After=munge.service network-online.target remote-fs.target sssd.service
Wants=network-online.target

[Service]
Type=notify
# Default to empty so an absent EnvironmentFile does not leave SLURMD_OPTIONS unset.
Environment=SLURMD_OPTIONS=
EnvironmentFile=-/etc/sysconfig/slurmd
EnvironmentFile=-/etc/default/slurmd
ExecStart=/usr/sbin/slurmd --systemd -N %i $SLURMD_OPTIONS
ExecReload=/bin/kill -HUP $MAINPID
PIDFile=/run/slurm/slurmd-%i.pid
KillMode=process
LimitNOFILE=131072
LimitMEMLOCK=infinity
LimitSTACK=infinity
Delegate=yes
TasksMax=infinity

[Install]
WantedBy=multi-user.target
