{% set args = ['--collector.slurm', '--web.listen-address=:' ~ ceems_exporter_port] %}
{% if ceems_node_type['gpus'] | length > 0 %}
{# The fake nvidia-smi replaces GPU discovery. Setting the GPU type skips the
   probe of PCI devices in sysfs, which shows the devices of the host. #}
{% set _ = args.extend(['--collector.gpu.type=nvidia', '--collector.gpu.nvidia-smi-path=' ~ ceems_nvidia_smi_path]) %}
{% else %}
{% set _ = args.append('--collector.gpu.type=nogpu') %}
{% endif %}
{% set _ = args.extend(ceems_exporter_extra_args) %}
[Service]
Environment="CEEMS_EXPORTER_OPTIONS={{ args | join(' ') }}"
