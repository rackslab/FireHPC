[Unit]
Description=FireHPC fake NVIDIA DCGM exporter
After=network.target

[Service]
# Root is required to read the environment of Slurm job processes in /proc.
ExecStart=/usr/bin/firehpc-dcgm-exporter
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
